{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Products available in the marketplace",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string", "enum": ["Tortas", "Kits", "Embalagens"] },
        "stock": { "type": "number" },
        "imageUrl": { "type": "string" },
        "isBestSeller": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "description", "price", "category", "stock", "imageUrl"]
    },
    "City": {
      "title": "City",
      "description": "Cities served by the bakery",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "deliveryDays": { "type": "array", "items": { "type": "number" } },
        "availableHours": { "type": "array", "items": { "type": "string" } },
        "maxDailyOrders": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["name", "deliveryDays", "availableHours", "maxDailyOrders"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer orders",
      "type": "object",
      "properties": {
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "address": { "type": "string" },
        "cityId": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "deliveryDate": { "type": "string", "format": "date" },
        "deliveryTime": { "type": "string" },
        "status": { "type": "string", "enum": ["pendente", "confirmado", "entregue", "cancelado"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerName", "customerPhone", "address", "cityId", "items", "total", "deliveryDate", "deliveryTime", "status"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer reviews",
      "type": "object",
      "properties": {
        "customerName": { "type": "string" },
        "comment": { "type": "string" },
        "rating": { "type": "number" },
        "isApproved": { "type": "boolean" },
        "isFeatured": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerName", "comment", "rating", "isApproved"]
    },
    "Post": {
      "title": "Post",
      "description": "Blog posts or news",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "imageUrl": { "type": "string" },
        "isFeatured": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "imageUrl"]
    },
    "Settings": {
      "title": "Settings",
      "description": "General application settings",
      "type": "object",
      "properties": {
        "instagramUrl": { "type": "string" },
        "whatsappUrl": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "followerCount": { "type": "number" },
        "dailyProductionLimit": { "type": "number" },
        "shopAddress": { "type": "string" },
        "localDeliveryEnabled": { "type": "boolean" },
        "heroImageUrl": { "type": "string" },
        "logoUrl": { "type": "string" }
      }
    }
  },
  "firestore": {
    "products": { "schema": "Product", "description": "Collection of products" },
    "cities": { "schema": "City", "description": "Collection of cities served" },
    "orders": { "schema": "Order", "description": "Collection of orders" },
    "reviews": { "schema": "Review", "description": "Collection of customer reviews" },
    "posts": { "schema": "Post", "description": "Collection of blog posts" },
    "settings": { "schema": "Settings", "description": "General settings document (expected to have ID 'general')" }
  }
}
