rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // For this app, we'll check if the user's email is the owner's email
      // In a real app, this would be a check against an 'admins' collection
      return isSignedIn() && (request.auth.token.email == 'docurasdosid@gmail.com' && request.auth.token.email_verified == true);
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Products
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']));
    }

    // Cities
    match /cities/{cityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Posts
    match /posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if resource.data.isApproved == true || isAdmin();
      allow create: if true; // Any customer can submit a review
      allow update, delete: if isAdmin();
    }

    // Orders
    match /orders/{orderId} {
      allow read: if isAdmin(); // Only admin reads orders for now (unless we add customer login)
      allow create: if true; // Customers can create orders
      allow update, delete: if isAdmin();
    }
  }
}
